# =====================================================================
# Tablero CVProgreso · propiedades por ambiente (equivalente a application.properties)
#
# Cómo usarlo:
#   - Copie este archivo como .env (o .env.dev / .env.prod) y complete los valores.
#   - Las VARIABLES DE ENTORNO con el mismo nombre tienen prioridad sobre este archivo
#     (en Docker: -e CVP_DB_PASSWORD=... o --env-file .env.prod).
#   - Para elegir otro archivo: CVP_ENV_FILE=/ruta/.env.prod   o   --env-file /ruta/.env.prod
#   - NO suba el .env real a ningún repositorio (contiene la contraseña de la base).
# =====================================================================

# Nombre del ambiente (solo informativo, aparece en el log): local | dev | qa | prod
CVP_AMBIENTE=local

# ---------------------------------------------------------------------
# BASE DE DATOS (solo lectura). Use UNA de las tres formas:
# ---------------------------------------------------------------------
# A) Cadena de conexión (recomendada). Si la clave tiene caracteres especiales, codifíquela (%40 para @, etc.)
#CVP_DB_URL=postgresql://usuario_ro:clave@host-bd:5432/viviendacvp?sslmode=require

# B) Campos sueltos
CVP_DB_HOST=
CVP_DB_PORT=5432
CVP_DB_NAME=viviendacvp
CVP_DB_USER=
CVP_DB_PASSWORD=
#CVP_DB_SSLMODE=require

# C) DSN ODBC ya configurado en el equipo (requiere pip install pyodbc), p. ej. el "CVP" de Power BI
#CVP_DB_DSN=CVP

# Tiempos máximos
CVP_DB_TIMEOUT_SEG=15
CVP_DB_STATEMENT_TIMEOUT_SEG=120

# ---------------------------------------------------------------------
# APLICACIÓN WEB
# ---------------------------------------------------------------------
# Carpeta donde está Tablero_CVP.html y donde se escribe data.js
# (en Docker, el volumen que sirve el servidor web, p. ej. /usr/share/nginx/html).
# Vacío = la carpeta de los scripts.
CVP_WEB_DIR=

# ---------------------------------------------------------------------
# REGLAS DEL PROGRAMA (cambian solo si cambia el programa, no entre ambientes)
# ---------------------------------------------------------------------
# Contratos que son lotes del tablero (1-4 de 2026). El 2849 es interventoría y NO va.
CVP_CONTRATOS=2844,2846,2847,2848
CVP_LOTES_NOMBRES=2844=Bosa Lote 1;2846=Bosa Lote 2;2847=Suba Lote 1;2848=Suba Lote 2
CVP_META_LOTE=220
CVP_FECHA_INICIO=2026-06-01
CVP_FECHA_FIN=2026-12-31

# =====================================================================
# Tablero CVProgreso · propiedades para la prueba con Docker
#   Uso:  cp .env.docker.example .env      (en Windows: copy .env.docker.example .env)
# Reglas de este archivo (lo lee docker compose, no cvp_config.py):
#   - una linea CLAVE=valor, SIN comillas y SIN comentarios en la misma linea del valor
#   - los comentarios van en lineas aparte que empiezan por #
#   - NO suba el .env real a ningun repositorio
# CVP_WEB_DIR no se define aqui: docker-compose.yml lo fija en /web y siempre gana.
# =====================================================================

CVP_AMBIENTE=docker-local

# Cada cuantas horas se repite la actualizacion. 0 = una sola vez y el contenedor termina.
CVP_ACTUALIZAR_CADA_HORAS=24

# ---------------------------------------------------------------------
# BASE DE DATOS. Deje activo UN solo modo (A, B o C) y comente los otros.
# No combine CVP_DB_URL con los campos CVP_DB_HOST/USER/PASSWORD: la URL tiene prioridad.
# ---------------------------------------------------------------------

# MODO A (activo): base de PRUEBA que levanta el propio compose con
#   docker compose --profile bd-prueba up --build
# Datos inventados, usuario de solo lectura de prueba. No toca ninguna base real.
CVP_DB_HOST=bd-prueba
CVP_DB_PORT=5432
CVP_DB_NAME=viviendacvp
CVP_DB_USER=tablero_ro
CVP_DB_PASSWORD=clave_de_prueba_no_real

# MODO B: base PostgreSQL que corre en la maquina del desarrollador (fuera de Docker).
# Comente las 5 lineas del modo A y descomente estas. Use un usuario de SOLO LECTURA.
# Esa base debe aceptar conexiones que vengan de Docker (listen_addresses y pg_hba.conf).
#CVP_DB_HOST=host.docker.internal
#CVP_DB_PORT=5432
#CVP_DB_NAME=viviendacvp
#CVP_DB_USER=usuario_solo_lectura
#CVP_DB_PASSWORD=poner_la_clave_aqui

# MODO C: base remota a la que se llega con VPN (la VPN se conecta en la maquina, no en Docker).
# Comente el modo A y descomente esta linea. Use un usuario de SOLO LECTURA.
# Si la clave tiene caracteres especiales, codifiquela (%40 para @, %23 para #, etc.).
#CVP_DB_URL=postgresql://usuario_solo_lectura:poner_la_clave_aqui@host-de-la-bd:5432/viviendacvp?sslmode=require

CVP_DB_TIMEOUT_SEG=15
CVP_DB_STATEMENT_TIMEOUT_SEG=120

# ---------------------------------------------------------------------
# REGLAS DEL PROGRAMA (iguales a .env.example; no cambian entre ambientes)
# ---------------------------------------------------------------------
CVP_CONTRATOS=2844,2846,2847,2848
CVP_LOTES_NOMBRES=2844=Bosa Lote 1;2846=Bosa Lote 2;2847=Suba Lote 1;2848=Suba Lote 2
CVP_META_LOTE=220
CVP_FECHA_INICIO=2026-06-01
CVP_FECHA_FIN=2026-12-31
